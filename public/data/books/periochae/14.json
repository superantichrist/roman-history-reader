      "paragraph": 1,
      "ref": "Liv. Per. 14.1",
      "original": "PYRRHUS in Siciliam traiecit.",
      "korean": "피로스는 시칠리아로 건너갔다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
