  "passages": [
    {
      "id": "periochae-20-per-001",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "1",
      "sectionStart": "1",
      "sectionEnd": "1",
      "sectionRefs": [
        "1"
      ],
      "paragraph": 1,
      "ref": "Liv. Per. 20.1",
      "original": "FALISCI cum rebellassent, sexto die perdomiti in deditionem venerunt.",
      "korean": "팔리스키인들은 반란을 일으켰다가 엿새 만에 완전히 제압되어 항복했다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-002",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "2",
      "sectionStart": "2",
      "sectionEnd": "2",
      "sectionRefs": [
        "2"
      ],
      "paragraph": 2,
      "ref": "Liv. Per. 20.2",
      "original": "Spoletium colonia deducta est.",
      "korean": "스폴레티움에 식민시가 건설되었다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-003",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "3",
      "sectionStart": "3",
      "sectionEnd": "3",
      "sectionRefs": [
        "3"
      ],
      "paragraph": 3,
      "ref": "Liv. Per. 20.3",
      "original": "adversus Liguras tunc primum exercitus promotus est.",
      "korean": "이때 처음으로 리구리아인들을 상대로 군대가 진군했다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-004",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "4",
      "sectionStart": "4",
      "sectionEnd": "4",
      "sectionRefs": [
        "4"
      ],
      "paragraph": 4,
      "ref": "Liv. Per. 20.4",
      "original": "sardi et Corsi cum rebellassent, subacti sunt.",
      "korean": "사르디니아인들과 코르시카인들은 반란을 일으켰다가 제압되었다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-005",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "5",
      "sectionStart": "5",
      "sectionEnd": "5",
      "sectionRefs": [
        "5"
      ],
      "paragraph": 5,
      "ref": "Liv. Per. 20.5",
      "original": "tuccia, virgo Vestalis, incesti damnata est.",
      "korean": "베스타 여사제 투키아는 정결 의무를 어긴 죄로 유죄 판결을 받았다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-006",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "6",
      "sectionStart": "6",
      "sectionEnd": "6",
      "sectionRefs": [
        "6"
      ],
      "paragraph": 6,
      "ref": "Liv. Per. 20.6",
      "original": "bellum Illyriis propter unum ex legatis qui ad eos missi erant occisum indictum est, subactique in deditionem venerunt.",
      "korean": "일리리아인들에게 파견된 사절 가운데 한 명이 살해되자 그들에게 전쟁이 선포되었다. 일리리아인들은 제압되어 항복했다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-007",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "7",
      "sectionStart": "7",
      "sectionEnd": "7",
      "sectionRefs": [
        "7"
      ],
      "paragraph": 7,
      "ref": "Liv. Per. 20.7",
      "original": "praetorum numerus ampliatus est, ut essent IIII.",
      "korean": "법무관의 수가 늘어나 모두 네 명이 되었다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-008",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "8",
      "sectionStart": "8",
      "sectionEnd": "8",
      "sectionRefs": [
        "8"
      ],
      "paragraph": 8,
      "ref": "Liv. Per. 20.8",
      "original": "Galli transalpini qui in Italiam inruperant caesi sunt.",
      "korean": "이탈리아로 침입한 알프스 너머의 갈리아인들이 섬멸되었다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-009",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "9",
      "sectionStart": "9",
      "sectionEnd": "9",
      "sectionRefs": [
        "9"
      ],
      "paragraph": 9,
      "ref": "Liv. Per. 20.9",
      "original": "eo bello populum R. sui Latinique nominis D̅C̅C̅C̅ armatorum habuisse dicit.",
      "korean": "이 전쟁 당시 로마 인민이 로마인과 라틴계 동맹군을 합쳐 무장 병력 80만 명을 보유했다고 저자는 말한다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-010",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "10",
      "sectionStart": "10",
      "sectionEnd": "10",
      "sectionRefs": [
        "10"
      ],
      "paragraph": 10,
      "ref": "Liv. Per. 20.10",
      "original": "Exercitibus Romanis tunc primum trans Padum ductis Galli Insubres aliquot proeliis fusi in deditionem venerunt.",
      "korean": "로마군이 이때 처음으로 파두스강 너머로 진군했으며, 인수브레스 갈리아인들은 몇 차례 전투에서 패한 끝에 항복했다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-011",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "11",
      "sectionStart": "11",
      "sectionEnd": "11",
      "sectionRefs": [
        "11"
      ],
      "paragraph": 11,
      "ref": "Liv. Per. 20.11",
      "original": "M. Claudius Marcellus cos. occiso Gallorum Insubrium duce, Vertomaro, opima spolia rettulit.",
      "korean": "집정관 마르쿠스 클라우디우스 마르켈루스는 인수브레스 갈리아인의 지휘관 베르토마루스를 죽이고 최고 전리품을 바쳤다.",
      "notes": [
        {
          "label": "최고 전리품",
          "text": "spolia opima. 로마의 지휘관이 직접 적군 지휘관을 죽이고 빼앗아 유피테르 페레트리우스에게 바친 무구다."
        }
      ],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-012",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "12",
      "sectionStart": "12",
      "sectionEnd": "12",
      "sectionRefs": [
        "12"
      ],
      "paragraph": 12,
      "ref": "Liv. Per. 20.12",
      "original": "Histri subacti sunt.",
      "korean": "히스트리아인들이 제압되었다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-013",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "13",
      "sectionStart": "13",
      "sectionEnd": "13",
      "sectionRefs": [
        "13"
      ],
      "paragraph": 13,
      "ref": "Liv. Per. 20.13",
      "original": "iterum Illyri cum rebellassent, domiti in deditionem venerunt.",
      "korean": "일리리아인들은 다시 반란을 일으켰다가 진압되어 항복했다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-014",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "14",
      "sectionStart": "14",
      "sectionEnd": "14",
      "sectionRefs": [
        "14"
      ],
      "paragraph": 14,
      "ref": "Liv. Per. 20.14",
      "original": "lustrum a censoribus ter conditum est.",
      "korean": "감찰관들은 세 차례 인구조사를 마치고 정화 의식을 거행했다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-015",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "15",
      "sectionStart": "15",
      "sectionEnd": "15",
      "sectionRefs": [
        "15"
      ],
      "paragraph": 15,
      "ref": "Liv. Per. 20.15",
      "original": "primo lustro censa sunt civium capita C̅C̅L̅X̅X̅ ccxii.",
      "korean": "첫 번째 인구조사에서 시민은 27만 212명으로 집계되었다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-016",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "16",
      "sectionStart": "16",
      "sectionEnd": "16",
      "sectionRefs": [
        "16"
      ],
      "paragraph": 16,
      "ref": "Liv. Per. 20.16",
      "original": "Libertini in quattuor tribus redacti sunt, cum antea dispersi per omnes fuissent, Esquilinam Palatinam Suburanam Collinam.",
      "korean": "해방노예들은 그전까지 모든 트리부스에 흩어져 있었으나 에스퀼리나·팔라티나·수부라나·콜리나, 네 트리부스로 한정되었다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-017",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "17",
      "sectionStart": "17",
      "sectionEnd": "17",
      "sectionRefs": [
        "17"
      ],
      "paragraph": 17,
      "ref": "Liv. Per. 20.17",
      "original": "C. Flaminius censor viam Flaminiam muniit et circum Flaminium exstruxit.",
      "korean": "감찰관 가이우스 플라미니우스는 플라미니아 가도를 닦고 플라미니우스 경기장을 세웠다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    },
    {
      "id": "periochae-20-per-018",
      "sourceId": "periochae",
      "book": 20,
      "chapter": "per",
      "section": "18",
      "sectionStart": "18",
      "sectionEnd": "18",
      "sectionRefs": [
        "18"
      ],
      "paragraph": 18,
      "ref": "Liv. Per. 20.18",
      "original": "coloniae deductae sunt in agro de Gallis capto Placentia et Cremona.",
      "korean": "갈리아인들에게서 빼앗은 영토에 플라켄티아와 크레모나 식민시가 건설되었다.",
      "notes": [],
      "translationStatus": "first-pass",
      "parallelRefs": []
    }
  ]
}
