      "sectionEnd": "7",
      "sectionRefs": [
        "7"
      ],
      "paragraph": 7,
      "ref": "Liv. Per. 17.7",
      "original": "Hannibal, dux Poenorum, victa classe cui praefuerat, a militibus suis in crucem sublatus est.",
      "korean": "",
      "notes": [],
      "translationStatus": "untranslated",
      "parallelRefs": []
