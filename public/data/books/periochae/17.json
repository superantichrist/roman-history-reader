      "sectionEnd": "3",
      "sectionRefs": [
        "3"
      ],
      "paragraph": 3,
      "ref": "Liv. Per. 17.3",
      "original": "C. Duillius consul adversus classem Poenorum prospere pugnavit, primusque omnium Romanorum ducum navalis victoriae duxit triumphum.",
      "korean": "",
      "notes": [],
      "translationStatus": "untranslated",
      "parallelRefs": []
    },
    {
      "id": "periochae-17-per-004",
      "sourceId": "periochae",
