      ],
      "paragraph": 2,
      "ref": "Liv. Per. 17.2",
      "original": "CORNELIUS consul a classe Punica circumventus et per fraudem, veluti in conloquium evocatus, captus est.",
      "korean": "",
      "notes": [],
      "translationStatus": "untranslated",
      "parallelRefs": []
    },
    {
