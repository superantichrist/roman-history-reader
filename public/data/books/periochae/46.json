      "sectionStart": "9",
      "sectionEnd": "9",
      "sectionRefs": [
        "9"
      ],
      "paragraph": 9,
      "ref": "Liv. Per. 46.9",
      "original": "Ariarathe, Cappadociae rege, mortuo filius eius Ariarathes regnum accepit et amicitiam cum populo Romano per legatos renovavit.",
      "korean": "",
      "notes": [],
      "translationStatus": "untranslated",
      "parallelRefs": []
    },
    {
      "id": "periochae-46-per-010",
      "sourceId": "periochae",
      "book": 46,
