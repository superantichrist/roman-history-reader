      "paragraph": 1,
      "ref": "Liv. Per. 46.1",
      "original": "Eumenes rex Romam venit, qui Macedonico bello medium egerat.",
      "korean": "",
      "notes": [],
      "translationStatus": "untranslated",
      "parallelRefs": []
    },
    {
