      "sectionRefs": [
        "12"
      ],
      "paragraph": 12,
      "ref": "Liv. Per. 46.12",
      "original": "L. Aemilius Paulus, qui Persen vicerat, mortuus.",
      "korean": "",
      "notes": [],
      "translationStatus": "untranslated",
