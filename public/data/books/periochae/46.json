      "sectionEnd": "8",
      "sectionRefs": [
        "8"
      ],
      "paragraph": 8,
      "ref": "Liv. Per. 46.8",
      "original": "Ptolemaeus Aegypti rex, pulsus regno a minore fratre missis ad cum legatis restitutus est.",
      "korean": "",
      "notes": [],
      "translationStatus": "untranslated",
      "parallelRefs": []
    },
    {
      "id": "periochae-46-per-009",
      "sourceId": "periochae",
      "book": 46,
      "chapter": "per",
