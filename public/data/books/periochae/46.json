      "sourceId": "periochae",
      "book": 46,
      "chapter": "per",
      "section": "11",
      "sectionStart": "11",
      "sectionEnd": "11",
      "sectionRefs": [
        "11"
      ],
      "paragraph": 11,
      "ref": "Liv. Per. 46.11",
      "original": "hunc Antiochum puerum cum Lysia tutore Demetrius Seleuci filius, qui Romae obses fuerat, clam, quia non dimittebatur, a Roma ⟦…⟧ interemit et ipse in regnum receptus.",
      "korean": "",
      "notes": [],
      "translationStatus": "untranslated",
      "parallelRefs": []
    },
