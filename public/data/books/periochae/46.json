      "sectionEnd": "3",
      "sectionRefs": [
        "3"
      ],
      "paragraph": 3,
      "ref": "Liv. Per. 46.3",
      "original": "Claudius Marcellus consul Alpinos Gallos, C. Sulpicius Gallus consul Liguras subegit.",
      "korean": "",
      "notes": [],
      "translationStatus": "untranslated",
      "parallelRefs": []
    },
    {
